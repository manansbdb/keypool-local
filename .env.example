# KeyPool Local — placeholders only (never commit real secrets)

LLM_KEYPOOL_DB=~/.llm-keypool/keys.db
LLM_KEYPOOL_MASTER_KEY_FILE=~/.llm-keypool/master.key
# Or: LLM_KEYPOOL_MASTER_KEY=  # Fernet key or passphrase

LLM_KEYPOOL_FREE_ONLY=true
LLM_KEYPOOL_ALLOW_PAID_FALLBACK=false
LLM_KEYPOOL_ROTATE_EVERY=5
LLM_KEYPOOL_LEGACY_IGNORE_MODEL=false

LLM_KEYPOOL_PROXY_TOKEN=replace-me
LLM_KEYPOOL_PROXY_REQUIRE_AUTH=true
